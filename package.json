{
  "name": "forge",
  "displayName": "Forge — Révision par l'action",
  "description": "Transforme tes Prosits et CER (CESI) en second cerveau Obsidian et t'aide à réviser en codant.",
  "version": "1.0.0",
  "publisher": "bouboule0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bouboule0/Forge"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "forge.reviser",
        "title": "Réviser",
        "category": "Forge",
        "icon": "$(mortar-board)"
      },
      {
        "command": "forge.ferme",
        "title": "Ma ferme",
        "category": "Forge",
        "icon": "$(home)"
      },
      {
        "command": "forge.statistiques",
        "title": "Statistiques",
        "category": "Forge",
        "icon": "$(graph)"
      },
      {
        "command": "forge.examens",
        "title": "Mes examens (préparer un CCTL ou une étude de cas)",
        "category": "Forge"
      },
      {
        "command": "forge.cctlBlanc",
        "title": "Examen blanc CCTL (questionnaire chronométré)",
        "category": "Forge"
      },
      {
        "command": "forge.verifierInstallation",
        "title": "Vérifier l'installation",
        "category": "Forge"
      },
      {
        "command": "forge.choisirCoffre",
        "title": "Créer / choisir le coffre Obsidian",
        "category": "Forge"
      },
      {
        "command": "forge.importer",
        "title": "Importer des CER / Prosits (.docx)",
        "category": "Forge"
      },
      {
        "command": "forge.nouveauProsit",
        "title": "Nouveau Prosit",
        "category": "Forge"
      },
      {
        "command": "forge.exporterWord",
        "title": "Exporter le CER en Word",
        "category": "Forge"
      },
      {
        "command": "forge.ouvrirCoffre",
        "title": "Ouvrir le coffre dans VS Code",
        "category": "Forge"
      },
      {
        "command": "forge.notionsARevoir",
        "title": "Notions à revoir",
        "category": "Forge"
      },
      {
        "command": "forge.configurerCleDeepSeek",
        "title": "Configurer la clé DeepSeek",
        "category": "Forge"
      },
      {
        "command": "forge.relireDefinitions",
        "title": "Faire relire les définitions par l'IA",
        "category": "Forge"
      },
      {
        "command": "forge.relireToutesDefinitions",
        "title": "Faire relire toutes les définitions par l'IA (même déjà relues)",
        "category": "Forge"
      },
      {
        "command": "forge.nouvelExercice",
        "title": "Nouvel exercice de code",
        "category": "Forge",
        "icon": "$(code)"
      },
      {
        "command": "forge.verifierExercice",
        "title": "Vérifier l'exercice",
        "category": "Forge",
        "icon": "$(play)"
      },
      {
        "command": "forge.mesExercices",
        "title": "Mes exercices de code",
        "category": "Forge"
      },
      {
        "command": "forge.etudeDeCas",
        "title": "Étude de cas sur papier (chronométrée)",
        "category": "Forge"
      },
      {
        "command": "forge.priseEnMain",
        "title": "Prise en main",
        "category": "Forge"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "forge.importer",
          "when": "resourceExtname == .docx",
          "group": "forge"
        },
        {
          "command": "forge.exporterWord",
          "when": "resourceExtname == .md",
          "group": "forge"
        },
        {
          "command": "forge.reviser",
          "when": "resourceExtname == .md",
          "group": "forge"
        }
      ],
      "editor/title/context": [
        {
          "command": "forge.exporterWord",
          "when": "resourceExtname == .md",
          "group": "forge"
        },
        {
          "command": "forge.reviser",
          "when": "resourceExtname == .md",
          "group": "forge"
        }
      ],
      "editor/title": [
        {
          "command": "forge.verifierExercice",
          "when": "resourceFilename == exercice.cpp",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Forge",
      "properties": {
        "forge.cheminCoffre": {
          "type": "string",
          "default": "",
          "markdownDescription": "Dossier du coffre Obsidian (second cerveau). Utilise la commande **Forge : Créer / choisir le coffre Obsidian** pour le remplir automatiquement."
        },
        "forge.compilateur": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Commande de compilation C++. `auto` = `wsl g++` sous Windows, `g++` ailleurs. Exemples : `wsl g++`, `g++`, `clang++`."
        },
        "forge.pandoc": {
          "type": "string",
          "default": "pandoc",
          "markdownDescription": "Commande pandoc utilisée pour l'export Word. Sous Windows, `wsl pandoc` fonctionne aussi si pandoc est installé dans WSL."
        },
        "forge.moduleParDefaut": {
          "type": "string",
          "default": "Programmation orientée objet",
          "description": "Module proposé à l'import quand le CER n'en indique pas."
        },
        "forge.modeleWord": {
          "type": "string",
          "default": "",
          "markdownDescription": "(Optionnel) Chemin d'un fichier Word dont l'export reprend les styles (polices, couleurs). Tu peux mettre l'un de tes CER .docx."
        },
        "forge.suggestionOuverture": {
          "type": "boolean",
          "default": true,
          "description": "Proposer une séance de révision à l'ouverture de VS Code (au plus une fois par jour) quand des notions sont à revoir."
        },
        "forge.definitionsIA": {
          "type": "string",
          "enum": [
            "accepter",
            "verifier"
          ],
          "default": "accepter",
          "enumDescriptions": [
            "Les définitions générées par IA sont acceptées d'office ; l'IA (DeepSeek) les relit et corrige celles qui sont fausses.",
            "Chaque définition générée par IA reste « à vérifier » jusqu'à ce que tu la valides pendant les révisions."
          ],
          "markdownDescription": "Que faire des définitions générées par IA dans tes CER ?"
        },
        "forge.relectureIAApresImport": {
          "type": "boolean",
          "default": true,
          "description": "Après un import, faire relire automatiquement les nouvelles définitions par l'IA (si une clé DeepSeek est enregistrée)."
        },
        "forge.deepseek.modele": {
          "type": "string",
          "default": "deepseek-chat",
          "description": "Modèle DeepSeek utilisé."
        },
        "forge.deepseek.url": {
          "type": "string",
          "default": "https://api.deepseek.com",
          "description": "Adresse de l'API DeepSeek (compatible OpenAI)."
        }
      }
    },
    "keybindings": [
      {
        "command": "forge.reviser",
        "key": "ctrl+alt+r",
        "mac": "cmd+alt+r"
      },
      {
        "command": "forge.verifierExercice",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorTextFocus && resourceExtname =~ /\\.(cpp|hpp|h)$/"
      }
    ],
    "walkthroughs": [
      {
        "id": "forge.priseEnMain",
        "title": "Bien démarrer avec Forge",
        "description": "Ton second cerveau de révision, de l'import des CER à la ferme.",
        "steps": [
          {
            "id": "installation",
            "title": "Vérifier l'installation",
            "description": "Compilateur C++ (WSL), pandoc, git.\n[Vérifier l'installation](command:forge.verifierInstallation)",
            "media": {
              "markdown": "media/prise-en-main/1-installation.md"
            },
            "completionEvents": [
              "onCommand:forge.verifierInstallation"
            ]
          },
          {
            "id": "coffre",
            "title": "Créer ton second cerveau",
            "description": "Le dossier Obsidian où vivront tes notes.\n[Créer mon coffre](command:forge.choisirCoffre)",
            "media": {
              "markdown": "media/prise-en-main/2-coffre.md"
            },
            "completionEvents": [
              "onSettingChanged:forge.cheminCoffre"
            ]
          },
          {
            "id": "import",
            "title": "Importer tes CER",
            "description": "Tes Word deviennent des notes reliées.\n[Importer mes CER](command:forge.importer)",
            "media": {
              "markdown": "media/prise-en-main/3-import.md"
            },
            "completionEvents": [
              "onCommand:forge.importer"
            ]
          },
          {
            "id": "ia",
            "title": "Ajouter l'IA (facultatif)",
            "description": "Corrections, exercices de code, études de cas.\n[Configurer la clé DeepSeek](command:forge.configurerCleDeepSeek)",
            "media": {
              "markdown": "media/prise-en-main/4-ia.md"
            },
            "completionEvents": [
              "onCommand:forge.configurerCleDeepSeek"
            ]
          },
          {
            "id": "reviser",
            "title": "Réviser",
            "description": "Ctrl+Alt+R, à tout moment.\n[Lancer une séance](command:forge.reviser)",
            "media": {
              "markdown": "media/prise-en-main/5-reviser.md"
            },
            "completionEvents": [
              "onCommand:forge.reviser"
            ]
          },
          {
            "id": "ferme",
            "title": "Ta ferme",
            "description": "Plante tes notions et fais-les pousser.\n[Ouvrir ma ferme](command:forge.ferme)",
            "media": {
              "markdown": "media/prise-en-main/6-ferme.md"
            },
            "completionEvents": [
              "onCommand:forge.ferme"
            ]
          },
          {
            "id": "examens",
            "title": "Préparer un examen",
            "description": "CCTL blanc, étude de cas blanche, statistiques.\n[Mes examens](command:forge.examens)",
            "media": {
              "markdown": "media/prise-en-main/7-examens.md"
            },
            "completionEvents": [
              "onCommand:forge.examens"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "essai-import": "node esbuild.mjs --script scripts/essai-import.ts && node dist/scripts/essai-import.js",
    "test": "node esbuild.mjs --script scripts/tests.ts && node --test dist/scripts/tests.js",
    "vscode:prepublish": "npm run typecheck && npm run build",
    "package": "vsce package"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "mammoth": "^1.13.0",
    "marked": "^18.2.1",
    "node-html-parser": "^9.0.7",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/turndown": "^5.0.5",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  },
  "icon": "media/icone.png",
  "galleryBanner": {
    "color": "#3b2a1e",
    "theme": "dark"
  },
  "keywords": [
    "révision",
    "CESI",
    "Prosit",
    "Obsidian",
    "C++",
    "répétition espacée",
    "flashcards"
  ]
}
